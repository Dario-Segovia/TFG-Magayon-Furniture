{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "magayon-furniture",
  "version": "0.3.0",
  "identifier": "com.magayon-furniture.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
   

    
  },
  "app": {
    "windows": [
      {
        "title": "magayon-furniture",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  

      
    
  
  }
}
